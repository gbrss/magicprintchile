---
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { href: string; label: string }[]; dark?: boolean }
const { eyebrow, title, lead, crumbs = [], dark = false } = Astro.props;
---
<section class:list={['ph', 'engrave', { dark }]}>
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        {crumbs.map((c) => <><span>/</span><a href={c.href}>{c.label}</a></>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  <div class="ph__ros" aria-hidden="true"></div>
</section>
<style>
  .ph { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem); border-bottom: 1px solid var(--line); }
  .ph .wrap { position: relative; z-index: 1; }
  .ph h1 { font-size: clamp(2.4rem, 5.5vw, 4.6rem); margin: 0.8rem 0 1rem; max-width: 18ch; }
  .ph h1 :global(em) { color: var(--red); }
  .dark.ph h1 :global(em) { color: var(--brass-2); }
  .ph__ros { position: absolute; right: -140px; top: 50%; translate: 0 -50%; width: 520px; aspect-ratio: 1; background: url('/ornaments/rosette-ink.svg') center / contain no-repeat; opacity: 0.35; animation: spin 160s linear infinite; }
  .dark .ph__ros { background-image: url('/ornaments/rosette-brass.svg'); opacity: 0.3; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.82rem; color: var(--muted); margin-bottom: 1.2rem; }
  .dark .crumbs { color: rgb(246 242 233 / 0.6); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  @media (max-width: 700px) { .ph__ros { width: 320px; right: -160px; opacity: 0.2; } }
</style>
