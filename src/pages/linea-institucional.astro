---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { INSTITUTIONAL, catBySlug, productsIn } from '../lib/catalog';
import { waLink } from '../lib/site';
const branches = [...INSTITUTIONAL, 'monedas', 'galvanos'].map((s) => ({ c: catBySlug(s)!, items: productsIn(s) }));
const occasions = ['Cambios de mando', 'Aniversarios de unidad', 'Despedidas y retiros', 'Ceremonias de graduación', 'Visitas protocolares', 'Reconocimientos'];
---
<Base title="Línea institucional: Armada, Ejército, Fuerza Aérea y Carabineros" description="Escudos de bronce fundido y resina, galvanos, bustos, cofres, monedas conmemorativas y regalos protocolares para Infantería de Marina, Litoral, Ejército, Fuerza Aérea y Carabineros.">
  <PageHead dark eyebrow="Defensa y Seguridad" title="Piezas que <em>honran</em> una trayectoria." lead="Escudos de bronce fundido, galvanos, bustos, cofres para gallardete y monedas conmemorativas. Fabricados con el detalle que exige el protocolo." crumbs={[{ href: '/linea-institucional/', label: 'Línea institucional' }]}>
    <div class="occ">{occasions.map((o) => <span class="chip">{o}</span>)}</div>
  </PageHead>
  <nav class="jump wrap" aria-label="Ramas">
    {branches.map(({ c }) => <a href={`#${c.slug}`}>{c.name}<small>{c.count}</small></a>)}
  </nav>
  {branches.map(({ c, items }, i) => (
    <section class:list={['section', 'section--tight', 'branch']} id={c.slug}>
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div><p class="eyebrow">{String(i + 1).padStart(2, '0')} · {c.count} productos</p><h2>{c.name}</h2></div>
          <p>{c.blurb}</p>
        </div>
        <div class="grid-products">{items.slice(0, 8).map((p) => <ProductCard product={p} />)}</div>
        <div class="more">
          <a class="btn btn--ghost" href={`/categoria/${c.slug}/`}>Ver {c.count > 8 ? `los ${c.count}` : 'todo'} en {c.name} <Icon name="arrow" /></a>
          <a class="btn btn--wa" href={waLink(`Hola MagicPrintChile, necesito cotizar para ${c.name}.`)} target="_blank" rel="noopener"><Icon name="wa" />Cotizar para {c.name}</a>
        </div>
      </div>
    </section>
  ))}
</Base>
<style>
  .occ { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.6rem; }
  .occ .chip { cursor: default; }
  .jump { position: sticky; top: 76px; z-index: 5; display: flex; gap: 0.4rem; overflow-x: auto; padding-block: 0.8rem; background: var(--paper); scrollbar-width: none; }
  .jump a { flex: none; display: inline-flex; gap: 0.4rem; align-items: center; padding: 0.5rem 0.9rem; border-radius: 999px; background: var(--white); border: 1px solid var(--line); text-decoration: none; font-size: 0.88rem; font-weight: 560; }
  .jump small { font-family: var(--f-mono); color: var(--muted); font-size: 0.7rem; }
  .branch { scroll-margin-top: 140px; border-bottom: 1px solid var(--line); }
  .branch:nth-of-type(even) { background: var(--paper-2); }
  .more { display: flex; gap: 0.7rem; flex-wrap: wrap; margin-top: 1.6rem; }
  @media (max-width: 640px) { .jump { top: 64px; } }
</style>
