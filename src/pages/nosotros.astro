---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { products } from '../lib/catalog';
import { waLink } from '../lib/site';
---
<Base title="Nosotros" description="MagicPrintChile es un taller chileno de personalización: galvanos, monedas, escudos de bronce, impresión en metales, grabado láser, sublimación y bordado.">
  <PageHead eyebrow="Nosotros" title="Un taller chileno de <em>personalización.</em>" lead="En MagicPrintChile combinamos impresión en metales, grabado láser, fundición en bronce, sublimación y bordado para crear piezas con identidad: desde un escudo para un cambio de mando hasta los tazones de tu empresa." crumbs={[{ href: '/nosotros/', label: 'Nosotros' }]} />
  <section class="section section--tight">
    <div class="wrap about">
      <div><strong>{products.length}</strong><span>productos en catálogo, todos personalizables</span></div>
      <div><strong>8</strong><span>técnicas de fabricación y personalización</span></div>
      <div><strong>5</strong><span>ramas de Defensa y Seguridad con catálogo propio</span></div>
    </div>
    <div class="wrap" style="margin-top:2.5rem">
      <a class="btn btn--wa" href={waLink('Hola MagicPrintChile, quiero conocer más sobre sus productos.')} target="_blank" rel="noopener"><Icon name="wa" />Conversemos</a>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .about div { padding: 2rem; border-radius: 24px; background: var(--white); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.4rem; }
  .about strong { font-family: var(--f-display); font-size: 3.6rem; font-weight: 500; line-height: 1; }
  .about span { color: var(--muted); }
  @media (max-width: 760px) { .about { grid-template-columns: 1fr; } }
</style>
